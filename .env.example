# Copy this file to ".env" and fill in your values.

# Required: the ID of your Google Sheet.
# It is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=paste-your-spreadsheet-id-here

# Path to the service-account JSON key (default: credentials.json in this folder)
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Optional: name used for the "delivering to" label on the form
# GOOGLE_SHEET_NAME=Form Submissions

# Optional: change Flask's secret key in production
# SECRET_KEY=change-me
